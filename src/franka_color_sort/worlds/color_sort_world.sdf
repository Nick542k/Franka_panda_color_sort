```xml
<?xml version="1.0"?>
<sdf version="1.8">

  <world name="color_sort_world">

    <!-- ==================== PHYSICS ==================== -->
    <physics name="physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ==================== SYSTEMS ==================== -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ==================== SUN ==================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==================== GROUND ==================== -->
    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ==================== TABLE ==================== -->
    <model name="sort_table">
      <static>true</static>
      <pose>0.6 0 0 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.4</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.35 0.2 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ==================== CAMERA ==================== -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.6 0 1.4 0 1.5708 0</pose>

      <link name="link">

        <sensor name="camera_sensor" type="rgbd_camera">

          <camera>
            <horizontal_fov>1.047</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
            </image>

            <clip>
              <near>0.1</near>
              <far>5</far>
            </clip>
          </camera>

          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>camera</topic>

        </sensor>

      </link>
    </model>


    <!-- ==================== GREEN CUBE ==================== -->
    <model name="green_cube">
      <pose>0.45 0.00 0.42 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.05</mass>

          <inertia>
            <ixx>1.333e-5</ixx>
            <iyy>1.333e-5</iyy>
            <izz>1.333e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>

          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ==================== RED CUBE ==================== -->
    <model name="red_cube">
      <pose>0.60 0.00 0.42 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.05</mass>

          <inertia>
            <ixx>1.333e-5</ixx>
            <iyy>1.333e-5</iyy>
            <izz>1.333e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ==================== BLUE CUBE ==================== -->
    <model name="blue_cube">
      <pose>0.30 -0.20 0.42 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.05</mass>

          <inertia>
            <ixx>1.333e-5</ixx>
            <iyy>1.333e-5</iyy>
            <izz>1.333e-5</izz>
            <ixy>0</ixy>
            <ixz>0</xz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>

          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ==================== DROP BASKET ==================== -->
    <model name="drop_basket">
      <static>true</static>
      <pose>0.6 -0.25 0.2 0 0 0</pose>

      <link name="link">

        <!-- Floor -->
        <collision name="floor">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.005</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.16 0.005</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>


        <!-- +X Wall -->
        <collision name="wall_plus_x">
          <pose>0.08 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.16 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_plus_x_visual">
          <pose>0.08 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.16 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>


        <!-- -X Wall -->
        <collision name="wall_minus_x">
          <pose>-0.08 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.16 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_minus_x_visual">
          <pose>-0.08 0 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.005 0.16 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>


        <!-- +Y Wall -->
        <collision name="wall_plus_y">
          <pose>0 0.08 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.005 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_plus_y_visual">
          <pose>0 0.08 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.005 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>


        <!-- -Y Wall -->
        <collision name="wall_minus_y">
          <pose>0 -0.08 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.005 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_minus_y_visual">
          <pose>0 -0.08 0.04 0 0 0</pose>
          <geometry>
            <box>
              <size>0.16 0.005 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>

</sdf>
```

